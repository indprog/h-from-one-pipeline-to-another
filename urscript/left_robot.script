# Configuration constants
GRIPPER_BOX_ADDR = "__GRIPPER_BOX_ADDR__"  # Replaced by Python
HOME = [d2r(90), d2r(-90), d2r(5), d2r(-70), d2r(-90), d2r(180)]
PICK_ABOVE = p[.4, -.1, .0, d2r(0), d2r(180), d2r(0)]  # Above pick pose

## YOUR CODE HERE

global GRIPPER_RPC = rpc_factory("xmlrpc", "http://" + GRIPPER_BOX_ADDR + ":41414")

# width range: [0, 110]
# force range: [0, 40]
def rg_grip(width, force = 10, tool_index = 0):
  GRIPPER_RPC.rg_grip(tool_index, width + .0, force + .0)
  # `+ .0` required, because rg_grip expects float

  sleep(0.01) # Wait for the gripper to start moving before checking rg_is_busy()
  while (GRIPPER_RPC.rg_get_busy(tool_index)):
  end
end

# Picks an item using the gripper with the given force
def pick(width = 0, force = 10):
  rg_grip(width, force)
end

# Places an item using the gripper
def place(width = 50, force = 0):
  rg_grip(width, force)
end


# Function test
movej(HOME)
pick()
while get_standard_digital_in(3) == False:  # Wait for sensor to activate.
  sleep(0.1)
end
place()

movej(PICK_ABOVE)

